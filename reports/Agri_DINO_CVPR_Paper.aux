\citation{kumar2022fine}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  \textbf  {Agri-DINO pipeline overview.} \emph  {Phase 1 (green):} A ViT-Base/16 student is trained via DINO momentum distillation on 5.17M unlabeled agricultural images. The teacher's parameters are updated by exponential moving average (EMA). \emph  {Phase 2 (red):} The pre-trained backbone is transferred to downstream tasks via a two-stage protocol: brief linear probing stabilizes the classification head before the full backbone is unfrozen with domain-calibrated layer-wise learning rate decay (LLRD, $\gamma {=}0.75$). Test-Time Augmentation (TTA) further improves inference accuracy. }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{3}{\textbf {Agri-DINO pipeline overview.} \emph {Phase 1 (green):} A ViT-Base/16 student is trained via DINO momentum distillation on 5.17M unlabeled agricultural images. The teacher's parameters are updated by exponential moving average (EMA). \emph {Phase 2 (red):} The pre-trained backbone is transferred to downstream tasks via a two-stage protocol: brief linear probing stabilizes the classification head before the full backbone is unfrozen with domain-calibrated layer-wise learning rate decay (LLRD, $\gamma {=}0.75$). Test-Time Augmentation (TTA) further improves inference accuracy}{figure.caption.1}{}}
