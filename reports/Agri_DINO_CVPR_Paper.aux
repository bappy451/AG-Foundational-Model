\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  \textbf  {Agri-DINO pipeline.} \emph  {Phase 1 (green):} Two global and four local views of each unlabeled agricultural image train a ViT-Base/16 student with DINO cross-view distillation; the teacher is updated by exponential moving average (EMA). \emph  {Phase 2 (red):} The resulting checkpoint is adapted with a five-epoch linear-probing warmup, followed by end-to-end fine-tuning with LLRD ($\gamma {=}0.75$) and horizontal-flip TTA. Solid arrows show the training path; the dashed arrow denotes the EMA update. }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{3}{\textbf {Agri-DINO pipeline.} \emph {Phase 1 (green):} Two global and four local views of each unlabeled agricultural image train a ViT-Base/16 student with DINO cross-view distillation; the teacher is updated by exponential moving average (EMA). \emph {Phase 2 (red):} The resulting checkpoint is adapted with a five-epoch linear-probing warmup, followed by end-to-end fine-tuning with LLRD ($\gamma {=}0.75$) and horizontal-flip TTA. Solid arrows show the training path; the dashed arrow denotes the EMA update}{figure.caption.1}{}}
