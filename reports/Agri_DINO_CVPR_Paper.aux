\newlabel{sec:corpus}{{3.1}{2}{\texorpdfstring {\hskip -1em.~}{}Pre-Training Corpus Audit}{subsection.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces  \textbf  {Agri-DINO two-row end-to-end architecture and adaptation pipeline.} \textbf  {(a)~Phase 1 (Top Row - Self-Supervised Domain-Adaptive Pre-Training):} Unlabeled agricultural images from \texttt  {Agri-Corpus-1.5M} undergo bounded multi-scale cropping to produce two global ($224\times 224$) and four local ($96\times 96$) views. A ViT-Base/16 student $\theta _s$ is trained by cross-view distillation against an exponential moving average (EMA) teacher $\theta _t$, using centered projection heads and Sinkhorn normalization. \textbf  {(b)~Phase 2 (Bottom Row - Structured Downstream Adaptation):} The adapted checkpoint $\theta _0$ is transferred to downstream tasks without human pre-training labels. Adaptation uses a 5-epoch linear-probing (LP) warmup with frozen transformer blocks, followed by end-to-end fine-tuning with layer-wise learning-rate decay (LLRD, $\gamma {=}0.75$). Horizontal-flip test-time augmentation (TTA) yields the final consensus prediction~$\hat  {y}$. }}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:pipeline}{{1}{3}{\textbf {Agri-DINO two-row end-to-end architecture and adaptation pipeline.} \textbf {(a)~Phase 1 (Top Row - Self-Supervised Domain-Adaptive Pre-Training):} Unlabeled agricultural images from \texttt {Agri-Corpus-1.5M} undergo bounded multi-scale cropping to produce two global ($224\times 224$) and four local ($96\times 96$) views. A ViT-Base/16 student $\theta _s$ is trained by cross-view distillation against an exponential moving average (EMA) teacher $\theta _t$, using centered projection heads and Sinkhorn normalization. \textbf {(b)~Phase 2 (Bottom Row - Structured Downstream Adaptation):} The adapted checkpoint $\theta _0$ is transferred to downstream tasks without human pre-training labels. Adaptation uses a 5-epoch linear-probing (LP) warmup with frozen transformer blocks, followed by end-to-end fine-tuning with layer-wise learning-rate decay (LLRD, $\gamma {=}0.75$). Horizontal-flip test-time augmentation (TTA) yields the final consensus prediction~$\hat {y}$}{figure.caption.1}{}}
