\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces  \textbf  {Training dynamics and layer-wise adaptation profile of Agri-DINO.} \textbf  {(a)} Validation accuracy trajectories on \texttt  {MedicinalPlant} across 50 fine-tuning epochs. During the initial 5-epoch linear-probing (LP) warmup (gray shaded region), the classifier head aligns to the pre-trained feature space while the backbone remains frozen. When LLRD fine-tuning begins at epoch~6, Agri-DINO reaches 59.67\%, close to the reported ImageNet-21k result of 59.99\%. \textbf  {(b)} Layer-wise learning-rate decay (LLRD) multipliers $\eta _l/\eta _0 = \gamma ^{12-l}$ across the 12 ViT-Base/16 transformer blocks. With $\gamma {=}0.75$ (green solid line), early blocks ($l\le 4$) receive less than 10\% of the base rate, while later blocks receive larger updates for task-specific adaptation. }}{6}{figure.caption.8}\protected@file@percent }
\newlabel{fig:dynamics}{{2}{6}{\textbf {Training dynamics and layer-wise adaptation profile of Agri-DINO.} \textbf {(a)} Validation accuracy trajectories on \texttt {MedicinalPlant} across 50 fine-tuning epochs. During the initial 5-epoch linear-probing (LP) warmup (gray shaded region), the classifier head aligns to the pre-trained feature space while the backbone remains frozen. When LLRD fine-tuning begins at epoch~6, Agri-DINO reaches 59.67\%, close to the reported ImageNet-21k result of 59.99\%. \textbf {(b)} Layer-wise learning-rate decay (LLRD) multipliers $\eta _l/\eta _0 = \gamma ^{12-l}$ across the 12 ViT-Base/16 transformer blocks. With $\gamma {=}0.75$ (green solid line), early blocks ($l\le 4$) receive less than 10\% of the base rate, while later blocks receive larger updates for task-specific adaptation}{figure.caption.8}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces  \textbf  {PlantSeg audit under fragmented vs.\ corrected taxonomy.} Reported results use the fragmented 300-class conversion; corrected 20-category results are pending relabeling. All models use ViT-Base/16 at $256\!\times \!256$. }}{6}{table.caption.9}\protected@file@percent }
