\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces  \textbf  {PlantSeg benchmark audit: fragmented vs.\ corrected taxonomy.} Naive OBB suffix conversion creates 300 sample-specific micro-classes ($\approx 2.6\%$ chance accuracy), whereas our corrected taxonomy aggregates labels into true biological disease classes ($77.37\%$ to $79.37\%$ accuracy). }}{7}{table.caption.11}\protected@file@percent }
\newlabel{tab:plantseg}{{4}{7}{\textbf {PlantSeg benchmark audit: fragmented vs.\ corrected taxonomy.} Naive OBB suffix conversion creates 300 sample-specific micro-classes ($\approx 2.6\%$ chance accuracy), whereas our corrected taxonomy aggregates labels into true biological disease classes ($77.37\%$ to $79.37\%$ accuracy)}{table.caption.11}{}}
