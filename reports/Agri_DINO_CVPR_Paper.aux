\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces  \textbf  {Qualitative comparison of patch-token self-attention geometry.} \textbf  {(a)}~Supervised ImageNet-21k pre-training collapses patch tokens into global semantic logits, producing diffuse, high-entropy activation fields ($\mathcal  {H}=3.82$) that blend adjacent maize kernels and blur lesion boundaries. \textbf  {(b)}~Agri-DINO self-distillation preserves continuous spatial coordinates and localized neighborhood geometry, isolating sharp attention peaks ($\mathcal  {H}=1.41$) on distinct botanical structures. }}{7}{figure.caption.7}\protected@file@percent }
\newlabel{fig:attention}{{3}{7}{\textbf {Qualitative comparison of patch-token self-attention geometry.} \textbf {(a)}~Supervised ImageNet-21k pre-training collapses patch tokens into global semantic logits, producing diffuse, high-entropy activation fields ($\mathcal {H}=3.82$) that blend adjacent maize kernels and blur lesion boundaries. \textbf {(b)}~Agri-DINO self-distillation preserves continuous spatial coordinates and localized neighborhood geometry, isolating sharp attention peaks ($\mathcal {H}=1.41$) on distinct botanical structures}{figure.caption.7}{}}
